<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    품목관리 Mapper

    역할:
    - 기준정보관리 > 품목관리에서 사용하는 SQL을 관리한다.
    - item 테이블을 기준으로 품목 목록/상세/등록/수정/삭제를 처리한다.

    DB 기준:
    - 최신 safe_names 기준
    - 테이블명/컬럼명에 큰따옴표 사용 안 함

    관련 테이블:
    - item   : 품목 기준정보
    - client : 공급처/납품처 이름 조회용

    화면 기준:
    - PC 목록 테이블은 체크박스, 상세 포함 최대 8개 컬럼
    - 모바일 목록 테이블은 체크박스 제외, 상세 포함 최대 4개 컬럼
    - 목록에 보이지 않는 나머지 컬럼은 상세보기에서 출력
-->
<mapper namespace="item">

    <!--
        item 조회 결과를 ItemDTO에 매핑한다.

        DB 컬럼명:
        - item_id, item_code, safety_stock

        DTO 필드명:
        - itemId, itemCode, safetyStock

        컬럼명과 필드명이 다르기 때문에 resultMap으로 직접 연결한다.
    -->
    <resultMap id="itemResultMap" type="kr.or.saeroi.dto.ItemDTO">

        <!-- item 테이블 기본 컬럼 -->
        <id property="itemId" column="item_id" />

        <result property="supplierId" column="supplier_id" />
        <result property="clientId" column="client_id" />
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="safetyStock" column="safety_stock" />
        <result property="itemUnit" column="item_unit" />
        <result property="remark" column="remark" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="useYn" column="use_yn" />

        <!-- JOIN 조회 / 화면 표시용 컬럼 -->
        <result property="supplierName" column="supplier_name" />
        <result property="deliveryClientName" column="delivery_client_name" />
        <result property="itemTypeName" column="item_type_name" />
        <result property="useYnName" column="use_yn_name" />

    </resultMap>


    <!--
        품목 목록 조회

        사용 위치:
        - 기준정보관리 > 품목관리 목록 화면

        검색 방식:
        - 화면에는 "구분" selectbox 1개와 "검색어" input 1개만 있다.
        - searchType 값에 따라 검색 대상 컬럼이 달라진다.

        searchType 값:
        - itemCode           : 품목코드
        - itemName           : 품목명
        - itemType           : 품목구분
        - supplierName       : 공급처
        - deliveryClientName : 납품처

        주의:
        - 목록 화면에서 모든 컬럼을 다 보여주지는 않는다.
        - 하지만 상세보기 재사용을 위해 필요한 표시용 값까지 함께 조회한다.
    -->
    <select id="selectItemList"
            parameterType="kr.or.saeroi.dto.ItemDTO"
            resultMap="itemResultMap">

        SELECT
            i.item_id,
            i.supplier_id,
            i.client_id,
            i.item_code,
            i.item_name,
            i.item_type,
            i.safety_stock,
            i.item_unit,
            i.remark,
            i.created_date,
            i.updated_date,
            i.use_yn,

            sup.client_name AS supplier_name,
            cus.client_name AS delivery_client_name,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN i.use_yn = 'Y' THEN '사용'
                WHEN i.use_yn = 'N' THEN '미사용'
                ELSE i.use_yn
            END AS use_yn_name

        FROM item i

        LEFT JOIN client sup
            ON sup.client_id = i.supplier_id

        LEFT JOIN client cus
            ON cus.client_id = i.client_id

        <where>
            <!--
                검색조건

                searchType과 searchKeyword가 둘 다 있을 때만 검색조건을 붙인다.
                searchType이 비어 있거나 검색어가 없으면 전체 목록을 조회한다.
            -->
            <if test="searchType != null and searchType != ''
                      and searchKeyword != null and searchKeyword != ''">

                <choose>

                    <!-- 품목코드 검색 -->
                    <when test="searchType == 'itemCode'">
                        AND UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 품목명 검색 -->
                    <when test="searchType == 'itemName'">
                        AND UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!--
                        품목구분 검색

                        DB 저장값:
                        - FG
                        - RM
                        - SM

                        화면 표시명:
                        - 완제품
                        - 원자재
                        - 부자재

                        그래서 검색어가 'FG'여도 검색되고,
                        '완제품'이어도 검색되게 처리한다.
                    -->
                    <when test="searchType == 'itemType'">
                        AND (
                            UPPER(i.item_type) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                            OR
                            CASE
                                WHEN i.item_type = 'FG' THEN '완제품'
                                WHEN i.item_type = 'RM' THEN '원자재'
                                WHEN i.item_type = 'SM' THEN '부자재'
                                ELSE i.item_type
                            END LIKE '%' || #{searchKeyword} || '%'
                        )
                    </when>

                    <!-- 공급처명 검색 -->
                    <when test="searchType == 'supplierName'">
                        AND UPPER(sup.client_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 납품처명 검색 -->
                    <when test="searchType == 'deliveryClientName'">
                        AND UPPER(cus.client_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                </choose>

            </if>
        </where>

        ORDER BY
            i.item_type,
            i.item_code

    </select>


    <!--
        품목 목록 총 건수 조회

        사용 위치:
        - 목록 상단의 "총 n건" 표시
        - 페이징 계산

        중요:
        - selectItemList와 검색조건이 반드시 같아야 한다.
        - 그래야 목록 개수와 실제 조회 결과가 일치한다.
    -->
    <select id="selectItemCount"
            parameterType="kr.or.saeroi.dto.ItemDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM item i

        LEFT JOIN client sup
            ON sup.client_id = i.supplier_id

        LEFT JOIN client cus
            ON cus.client_id = i.client_id

        <where>
            <if test="searchType != null and searchType != ''
                      and searchKeyword != null and searchKeyword != ''">

                <choose>

                    <!-- 품목코드 검색 -->
                    <when test="searchType == 'itemCode'">
                        AND UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 품목명 검색 -->
                    <when test="searchType == 'itemName'">
                        AND UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 품목구분 검색 -->
                    <when test="searchType == 'itemType'">
                        AND (
                            UPPER(i.item_type) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                            OR
                            CASE
                                WHEN i.item_type = 'FG' THEN '완제품'
                                WHEN i.item_type = 'RM' THEN '원자재'
                                WHEN i.item_type = 'SM' THEN '부자재'
                                ELSE i.item_type
                            END LIKE '%' || #{searchKeyword} || '%'
                        )
                    </when>

                    <!-- 공급처명 검색 -->
                    <when test="searchType == 'supplierName'">
                        AND UPPER(sup.client_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 납품처명 검색 -->
                    <when test="searchType == 'deliveryClientName'">
                        AND UPPER(cus.client_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                </choose>

            </if>
        </where>

    </select>


    <!--
        품목 상세 조회

        사용 위치:
        - 목록의 "상세" 버튼 클릭
        - 상세보기 페이지
        - 수정 화면에서 기존 데이터 불러오기

        조건:
        - item_id 기준으로 1건 조회
    -->
    <select id="selectItemDetail"
            parameterType="int"
            resultMap="itemResultMap">

        SELECT
            i.item_id,
            i.supplier_id,
            i.client_id,
            i.item_code,
            i.item_name,
            i.item_type,
            i.safety_stock,
            i.item_unit,
            i.remark,
            i.created_date,
            i.updated_date,
            i.use_yn,

            sup.client_name AS supplier_name,
            cus.client_name AS delivery_client_name,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN i.use_yn = 'Y' THEN '사용'
                WHEN i.use_yn = 'N' THEN '미사용'
                ELSE i.use_yn
            END AS use_yn_name

        FROM item i

        LEFT JOIN client sup
            ON sup.client_id = i.supplier_id

        LEFT JOIN client cus
            ON cus.client_id = i.client_id

        WHERE i.item_id = #{itemId}

    </select>


    <!--
        품목 등록

        사용 위치:
        - 품목 등록 모달 또는 등록 페이지

        item_id 생성 기준:
        - 현재 DB에는 별도 시퀀스 기준이 확정되어 있지 않으므로
          item_type별 ID 대역을 유지하면서 MAX + 1 방식으로 생성한다.

        ID 대역:
        - FG: 1001 ~ 1999
        - RM: 2001 ~ 2999
        - SM: 3001 ~ 3999

        주의:
        - 팀에서 시퀀스를 따로 만들기로 하면 selectKey 부분은 시퀀스 방식으로 바꾸는 것이 좋다.
    -->
    <insert id="insertItem"
            parameterType="kr.or.saeroi.dto.ItemDTO">

        <selectKey keyProperty="itemId" resultType="int" order="BEFORE">
            SELECT
                CASE
                    WHEN #{itemType} = 'FG' THEN
                        NVL(MAX(CASE WHEN item_id BETWEEN 1000 AND 1999 THEN item_id END), 1000) + 1
                    WHEN #{itemType} = 'RM' THEN
                        NVL(MAX(CASE WHEN item_id BETWEEN 2000 AND 2999 THEN item_id END), 2000) + 1
                    WHEN #{itemType} = 'SM' THEN
                        NVL(MAX(CASE WHEN item_id BETWEEN 3000 AND 3999 THEN item_id END), 3000) + 1
                    ELSE
                        NVL(MAX(item_id), 0) + 1
                END
            FROM item
        </selectKey>

        INSERT INTO item (
            item_id,
            supplier_id,
            client_id,
            item_code,
            item_name,
            item_type,
            safety_stock,
            item_unit,
            remark,
            created_date,
            updated_date,
            use_yn
        ) VALUES (
            #{itemId},
            #{supplierId},
            #{clientId},
            #{itemCode},
            #{itemName},
            #{itemType},
            #{safetyStock},
            #{itemUnit},
            #{remark},
            SYSDATE,
            SYSDATE,
            NVL(#{useYn}, 'Y')
        )

    </insert>


    <!--
        품목 수정

        사용 위치:
        - 품목 수정 모달 또는 수정 페이지

        기준:
        - item_id 기준으로 수정한다.
        - created_date는 최초 등록일이므로 수정하지 않는다.
        - updated_date는 수정 시점의 SYSDATE로 갱신한다.
    -->
    <update id="updateItem"
            parameterType="kr.or.saeroi.dto.ItemDTO">

        UPDATE item
        SET
            supplier_id = #{supplierId},
            client_id = #{clientId},
            item_code = #{itemCode},
            item_name = #{itemName},
            item_type = #{itemType},
            safety_stock = #{safetyStock},
            item_unit = #{itemUnit},
            remark = #{remark},
            updated_date = SYSDATE,
            use_yn = #{useYn}
        WHERE item_id = #{itemId}

    </update>


    <!--
        품목 선택 삭제

        사용 위치:
        - 목록 화면의 선택 삭제 버튼

        처리 방식:
        - 실제 DELETE가 아니라 use_yn을 'N'으로 바꾸는 소프트 삭제 방식이다.
        - 기준정보는 다른 테이블에서 참조될 수 있으므로 물리 삭제보다 미사용 처리가 안전하다.

        전달값:
        - itemIdList : 삭제할 item_id 목록
    -->
    <update id="deleteItemList"
            parameterType="java.util.List">

        UPDATE item
        SET
            use_yn = 'N',
            updated_date = SYSDATE
        WHERE item_id IN
        <foreach collection="list"
                 item="itemId"
                 open="("
                 separator=","
                 close=")">
            #{itemId}
        </foreach>

    </update>


    <!--
        품목코드 중복 확인

        사용 위치:
        - 등록 전 품목코드 중복 검사
        - 수정 시 현재 품목을 제외한 중복 검사

        설명:
        - itemId가 null이면 등록 중복검사
        - itemId가 있으면 수정 중복검사
    -->
    <select id="selectItemCodeCount"
            parameterType="kr.or.saeroi.dto.ItemDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM item
        WHERE item_code = #{itemCode}

        <if test="itemId != null">
            AND item_id != #{itemId}
        </if>

    </select>
    
        <!--
        거래처 자동완성 결과 매핑

        사용 위치:
        - 품목 등록 모달의 공급처 자동완성
        - 품목 등록 모달의 납품처 자동완성

        client 테이블 컬럼:
        - client_id
        - client_code
        - client_name
        - client_type

        ClientDTO 필드:
        - clientId
        - clientCode
        - clientName
        - clientType
    -->
    <resultMap id="clientAutoCompleteResultMap" type="kr.or.saeroi.dto.ClientDTO">
        <id property="clientId" column="client_id" />

        <result property="clientCode" column="client_code" />
        <result property="clientName" column="client_name" />
        <result property="clientType" column="client_type" />
        <result property="clientAdress" column="client_adress" />
        <result property="clientMan" column="client_man" />
        <result property="clientTel" column="client_tel" />
        <result property="clientDept" column="client_dept" />
        <result property="remark" column="remark" />
        <result property="useYn" column="use_yn" />
    </resultMap>


    <!--
        거래처 자동완성 조회

        사용 위치:
        - 품목 등록 모달의 공급처 input
        - 품목 등록 모달의 납품처 input

        요청 예:
        - clientType = SUP, keyword = 한국
          → 공급처 중 이름/코드에 "한국"이 포함된 거래처 조회

        - clientType = CUS, keyword = 현대
          → 납품처 중 이름/코드에 "현대"가 포함된 거래처 조회

        정렬 기준:
        1. 거래처명이 검색어와 정확히 일치하는 데이터
        2. 거래처명이 검색어로 시작하는 데이터
        3. 거래처명 또는 거래처코드에 검색어가 포함된 데이터
        4. 거래처명 오름차순

        제한:
        - 자동완성 목록이 너무 길어지지 않도록 최대 10건만 조회한다.
    -->
    <select id="selectClientAutoComplete"
            parameterType="map"
            resultMap="clientAutoCompleteResultMap">

        SELECT
            client_id,
            client_code,
            client_name,
            client_type,
            client_adress,
            client_man,
            client_tel,
            client_dept,
            remark,
            use_yn
        FROM (
            SELECT
                client_id,
                client_code,
                client_name,
                client_type,
                client_adress,
                client_man,
                client_tel,
                client_dept,
                remark,
                use_yn
            FROM client
            WHERE use_yn = 'Y'

              <!-- 공급처/납품처 구분 -->
              AND client_type = #{clientType}

              <!-- 사용자가 입력한 검색어로 거래처명 또는 거래처코드 검색 -->
              AND (
                    UPPER(client_name) LIKE '%' || UPPER(#{keyword}) || '%'
                    OR UPPER(client_code) LIKE '%' || UPPER(#{keyword}) || '%'
              )

            ORDER BY
                CASE
                    WHEN UPPER(client_name) = UPPER(#{keyword}) THEN 1
                    WHEN UPPER(client_name) LIKE UPPER(#{keyword}) || '%' THEN 2
                    ELSE 3
                END,
                client_name
        )
        WHERE ROWNUM &lt;= 10

    </select>


    <!--
        다음 품목코드 자동생성

        사용 위치:
        - 품목 등록 모달에서 "자동생성" 버튼 클릭 시 호출

        입력값:
        - itemCodePrefix

        예:
        - itemCodePrefix = FG-GSK-ION5-EPDM

        기존 데이터:
        - FG-GSK-ION5-EPDM-001

        반환값:
        - FG-GSK-ION5-EPDM-002

        동작 방식:
        1. item_code가 prefix + '-숫자3자리' 형태인 데이터를 찾는다.
        2. 뒤쪽 숫자 3자리 중 가장 큰 값을 구한다.
        3. 가장 큰 값 + 1을 한다.
        4. 다시 3자리로 LPAD 처리한다.
        5. prefix와 합쳐 최종 품목코드를 만든다.

        주의:
        - itemCodePrefix에는 뒤 순번을 제외한 중요코드만 전달한다.
        - 예: FG-GSK-ION5-EPDM
        - 잘못된 예: FG-GSK-ION5-EPDM-001
    -->
    <select id="selectNextItemCode"
            parameterType="map"
            resultType="string">

        SELECT
            #{itemCodePrefix} || '-' ||
            LPAD(
                NVL(
                    MAX(
                        TO_NUMBER(
                            SUBSTR(item_code, LENGTH(#{itemCodePrefix}) + 2)
                        )
                    ),
                    0
                ) + 1,
                3,
                '0'
            ) AS next_item_code
        FROM item
        WHERE item_code LIKE #{itemCodePrefix} || '-%'
          AND REGEXP_LIKE(
                SUBSTR(item_code, LENGTH(#{itemCodePrefix}) + 2),
                '^[0-9]{3}$'
          )

    </select>

</mapper>