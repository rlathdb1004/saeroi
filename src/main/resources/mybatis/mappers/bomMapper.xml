<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    BOM관리 Mapper

    역할:
    - 기준정보관리 > BOM관리에서 사용하는 SQL을 관리한다.
    - bom 테이블과 bom_detail 테이블을 기준으로 BOM 목록/상세/등록/수정/삭제를 처리한다.

    DB 기준:
    - 최신 safe_names 기준
    - 테이블명/컬럼명에 큰따옴표 사용 안 함

    관련 테이블:
    - bom        : BOM 마스터
    - bom_detail : BOM 상세 구성품
    - item       : 완제품/원자재/부자재 품목명 조회용

    화면 기준:
    - 품목관리 ItemMapper.xml 구조 기준
    - Controller에서 전체 목록 조회 후 subList로 페이징 처리
    - Mapper에서는 ROWNUM 페이징 처리하지 않음
-->
<mapper namespace="bom">

    <!-- =========================================================
         1. ResultMap
         ========================================================= -->

    <!--
        BOM 마스터 조회 결과를 BomDTO에 매핑한다.
    -->
    <resultMap id="bomResultMap" type="kr.or.saeroi.dto.BomDTO">

        <!-- bom 테이블 기본 컬럼 -->
        <id property="bomId" column="bom_id" />

        <result property="bomCode" column="bom_code" />
        <result property="version" column="version" />
        <result property="useYn" column="use_yn" />
        <result property="remark" column="remark" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="itemId" column="item_id" />

        <!-- JOIN 조회 / 화면 표시용 컬럼 -->
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="itemTypeName" column="item_type_name" />
        <result property="itemUnit" column="item_unit" />
        <result property="useYnName" column="use_yn_name" />
        <result property="detailCount" column="detail_count" />

    </resultMap>


    <!--
        BOM 상세 조회 결과를 BomDetailDTO에 매핑한다.
    -->
    <resultMap id="bomDetailResultMap" type="kr.or.saeroi.dto.BomDetailDTO">

        <!-- bom_detail 테이블 기본 컬럼 -->
        <id property="bomDetailId" column="bom_detail_id" />

        <result property="bomId" column="bom_id" />
        <result property="qty" column="qty" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="remark" column="remark" />
        <result property="itemId" column="item_id" />

        <!-- 투입 품목 표시용 컬럼 -->
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="itemTypeName" column="item_type_name" />
        <result property="itemUnit" column="item_unit" />

        <!-- BOM 마스터 표시용 컬럼 -->
        <result property="bomCode" column="bom_code" />
        <result property="version" column="version" />
        <result property="useYn" column="use_yn" />
        <result property="useYnName" column="use_yn_name" />

        <!-- 완제품 표시용 컬럼 -->
        <result property="productItemId" column="product_item_id" />
        <result property="productItemCode" column="product_item_code" />
        <result property="productItemName" column="product_item_name" />
        <result property="productItemType" column="product_item_type" />
        <result property="productItemTypeName" column="product_item_type_name" />
        <result property="productItemUnit" column="product_item_unit" />

    </resultMap>


    <!--
        BOM 화면 자동완성용 ItemDTO 매핑
    -->
    <resultMap id="itemAutoCompleteResultMap" type="kr.or.saeroi.dto.ItemDTO">

        <id property="itemId" column="item_id" />

        <result property="supplierId" column="supplier_id" />
        <result property="clientId" column="client_id" />
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="safetyStock" column="safety_stock" />
        <result property="itemUnit" column="item_unit" />
        <result property="remark" column="remark" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="useYn" column="use_yn" />

        <result property="itemTypeName" column="item_type_name" />
        <result property="useYnName" column="use_yn_name" />

    </resultMap>


    <!-- =========================================================
         2. 공통 검색조건
         ========================================================= -->

    <!--
        BOM 목록 검색조건

        searchType 값:
        - bomCode  : BOM코드
        - itemCode : 완제품코드
        - itemName : 완제품명
        - useYn    : 사용여부

        주의:
        - selectBomList와 selectBomCount에서 같은 조건을 사용한다.
    -->
    <sql id="bomSearchWhere">

        <where>
            <if test="searchType != null and searchType != ''
                      and searchKeyword != null and searchKeyword != ''">

                <choose>

                    <!-- BOM코드 검색 -->
                    <when test="searchType == 'bomCode'">
                        AND UPPER(b.bom_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 완제품코드 검색 -->
                    <when test="searchType == 'itemCode'">
                        AND UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 완제품명 검색 -->
                    <when test="searchType == 'itemName'">
                        AND UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 사용여부 검색 -->
                    <when test="searchType == 'useYn'">
                        AND (
                            UPPER(b.use_yn) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                            OR
                            CASE
                                WHEN b.use_yn = 'Y' THEN '사용'
                                WHEN b.use_yn = 'N' THEN '미사용'
                                ELSE b.use_yn
                            END LIKE '%' || #{searchKeyword} || '%'
                        )
                    </when>

                </choose>

            </if>
        </where>

    </sql>


    <!-- =========================================================
         3. BOM 마스터 목록 / 상세
         ========================================================= -->

    <!--
        BOM 목록 조회

        사용 위치:
        - 기준정보관리 > BOM관리 목록 화면

        중요:
        - 품목관리 기준에 맞춰 Mapper에서 ROWNUM 페이징하지 않는다.
        - Controller에서 전체 목록을 받은 뒤 subList로 현재 페이지 목록만 자른다.
    -->
    <select id="selectBomList"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultMap="bomResultMap">

        SELECT
            b.bom_id,
            b.bom_code,
            b.version,
            b.use_yn,
            b.remark,
            b.created_date,
            b.updated_date,
            b.item_id,

            i.item_code,
            i.item_name,
            i.item_type,
            i.item_unit,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            NVL(bd.detail_count, 0) AS detail_count

        FROM bom b

        LEFT JOIN item i
            ON i.item_id = b.item_id

        LEFT JOIN (
            SELECT
                bom_id,
                COUNT(*) AS detail_count
            FROM bom_detail
            GROUP BY bom_id
        ) bd
            ON bd.bom_id = b.bom_id

        <include refid="bomSearchWhere" />

        ORDER BY
            b.bom_id DESC

    </select>


    <!--
        BOM 목록 총 건수 조회

        사용 위치:
        - 목록 상단 총 건수
        - Controller 페이징 계산

        중요:
        - selectBomList와 검색조건이 반드시 같아야 한다.
    -->
    <select id="selectBomCount"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom b

        LEFT JOIN item i
            ON i.item_id = b.item_id

        <include refid="bomSearchWhere" />

    </select>


    <!--
        BOM 상세 기본정보 조회

        사용 위치:
        - 목록의 상세 버튼 클릭
        - BOM 상세보기 페이지 상단 기본정보
    -->
    <select id="selectBomDetail"
            parameterType="int"
            resultMap="bomResultMap">

        SELECT
            b.bom_id,
            b.bom_code,
            b.version,
            b.use_yn,
            b.remark,
            b.created_date,
            b.updated_date,
            b.item_id,

            i.item_code,
            i.item_name,
            i.item_type,
            i.item_unit,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            NVL(bd.detail_count, 0) AS detail_count

        FROM bom b

        LEFT JOIN item i
            ON i.item_id = b.item_id

        LEFT JOIN (
            SELECT
                bom_id,
                COUNT(*) AS detail_count
            FROM bom_detail
            GROUP BY bom_id
        ) bd
            ON bd.bom_id = b.bom_id

        WHERE b.bom_id = #{bomId}

    </select>


    <!-- =========================================================
         4. BOM 마스터 등록 / 수정 / 삭제
         ========================================================= -->

    <!--
        BOM 등록

        bom_id 생성 기준:
        - 현재 DB에는 별도 시퀀스가 없으므로 MAX + 1 방식으로 생성한다.
        - insert 후 BomDTO.bomId에 생성된 값이 담긴다.
    -->
    <insert id="insertBom"
            parameterType="kr.or.saeroi.dto.BomDTO">

        <selectKey keyProperty="bomId" resultType="int" order="BEFORE">
            SELECT NVL(MAX(bom_id), 0) + 1
            FROM bom
        </selectKey>

        INSERT INTO bom (
            bom_id,
            bom_code,
            version,
            use_yn,
            remark,
            created_date,
            updated_date,
            item_id
        ) VALUES (
            #{bomId},
            #{bomCode},
            #{version},
            NVL(#{useYn}, 'Y'),
            #{remark},
            SYSDATE,
            SYSDATE,
            #{itemId}
        )

    </insert>


    <!--
        BOM 수정

        기준:
        - bom_id 기준으로 수정한다.
        - created_date는 최초 등록일이므로 수정하지 않는다.
        - updated_date는 수정 시점의 SYSDATE로 갱신한다.
    -->
    <update id="updateBom"
            parameterType="kr.or.saeroi.dto.BomDTO">

        UPDATE bom
        SET
            bom_code = #{bomCode},
            version = #{version},
            use_yn = NVL(#{useYn}, 'Y'),
            remark = #{remark},
            updated_date = SYSDATE,
            item_id = #{itemId}
        WHERE bom_id = #{bomId}

    </update>


    <!--
        BOM 선택 삭제

        처리 방식:
        - 실제 DELETE가 아니라 use_yn = 'N'으로 변경한다.
        - 기준정보는 다른 테이블에서 참조될 수 있으므로 물리 삭제보다 미사용 처리가 안전하다.

        전달값:
        - bomIdList : 삭제할 bom_id 목록
    -->
    <update id="deleteBomList"
            parameterType="java.util.List">

        UPDATE bom
        SET
            use_yn = 'N',
            updated_date = SYSDATE
        WHERE bom_id IN
        <foreach collection="list"
                 item="bomId"
                 open="("
                 separator=","
                 close=")">
            #{bomId}
        </foreach>

    </update>


    <!--
        BOM코드 중복 확인

        사용 위치:
        - 등록 전 BOM코드 중복 검사
        - 수정 시 현재 BOM을 제외한 중복 검사

        설명:
        - bomId가 null이면 등록 중복검사
        - bomId가 있으면 수정 중복검사
    -->
    <select id="selectBomCodeCount"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom
        WHERE bom_code = #{bomCode}

        <if test="bomId != null">
            AND bom_id != #{bomId}
        </if>

    </select>


    <!--
        다음 BOM코드 자동생성

        사용 위치:
        - BOM 등록 모달에서 완제품 선택 후 호출

        입력:
        - itemId

        예:
        - 완제품 코드: FG-GSK-ION5-EPDM-001
        - 반환 BOM코드: BOM-FG-GSK-ION5-EPDM-001
    -->
    <select id="selectNextBomCode"
            parameterType="int"
            resultType="string">

        SELECT
            'BOM-' || i.item_code
        FROM item i
        WHERE i.item_id = #{itemId}

    </select>


    <!--
        다음 BOM 버전 조회

        사용 위치:
        - BOM 등록 모달에서 완제품 선택 후 호출

        기준:
        - 같은 완제품 item_id의 MAX(version) + 1
        - 기존 BOM이 없으면 1
    -->
    <select id="selectNextBomVersion"
            parameterType="int"
            resultType="int">

        SELECT
            NVL(MAX(version), 0) + 1
        FROM bom
        WHERE item_id = #{itemId}

    </select>


    <!-- =========================================================
         5. BOM 상세 구성품 목록 / 단건
         ========================================================= -->

    <!--
        BOM 상세 구성품 목록 조회

        사용 위치:
        - BOM 상세보기 페이지
        - 해당 BOM에 연결된 원자재/부자재 구성품 목록 출력
    -->
    <select id="selectBomDetailList"
            parameterType="int"
            resultMap="bomDetailResultMap">

        SELECT
            bd.bom_detail_id,
            bd.bom_id,
            bd.qty,
            bd.created_date,
            bd.updated_date,
            bd.remark,
            bd.item_id,

            mat.item_code,
            mat.item_name,
            mat.item_type,
            mat.item_unit,

            CASE
                WHEN mat.item_type = 'FG' THEN '완제품'
                WHEN mat.item_type = 'RM' THEN '원자재'
                WHEN mat.item_type = 'SM' THEN '부자재'
                ELSE mat.item_type
            END AS item_type_name,

            b.bom_code,
            b.version,
            b.use_yn,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            fg.item_id AS product_item_id,
            fg.item_code AS product_item_code,
            fg.item_name AS product_item_name,
            fg.item_type AS product_item_type,
            fg.item_unit AS product_item_unit,

            CASE
                WHEN fg.item_type = 'FG' THEN '완제품'
                WHEN fg.item_type = 'RM' THEN '원자재'
                WHEN fg.item_type = 'SM' THEN '부자재'
                ELSE fg.item_type
            END AS product_item_type_name

        FROM bom_detail bd

        LEFT JOIN item mat
            ON mat.item_id = bd.item_id

        LEFT JOIN bom b
            ON b.bom_id = bd.bom_id

        LEFT JOIN item fg
            ON fg.item_id = b.item_id

        WHERE bd.bom_id = #{bomId}

        ORDER BY
            bd.bom_detail_id

    </select>


    <!--
        BOM 상세 구성품 단건 조회

        사용 위치:
        - 구성품 수정 또는 검증 보조
    -->
    <select id="selectBomDetailOne"
            parameterType="int"
            resultMap="bomDetailResultMap">

        SELECT
            bd.bom_detail_id,
            bd.bom_id,
            bd.qty,
            bd.created_date,
            bd.updated_date,
            bd.remark,
            bd.item_id,

            mat.item_code,
            mat.item_name,
            mat.item_type,
            mat.item_unit,

            CASE
                WHEN mat.item_type = 'FG' THEN '완제품'
                WHEN mat.item_type = 'RM' THEN '원자재'
                WHEN mat.item_type = 'SM' THEN '부자재'
                ELSE mat.item_type
            END AS item_type_name,

            b.bom_code,
            b.version,
            b.use_yn,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            fg.item_id AS product_item_id,
            fg.item_code AS product_item_code,
            fg.item_name AS product_item_name,
            fg.item_type AS product_item_type,
            fg.item_unit AS product_item_unit,

            CASE
                WHEN fg.item_type = 'FG' THEN '완제품'
                WHEN fg.item_type = 'RM' THEN '원자재'
                WHEN fg.item_type = 'SM' THEN '부자재'
                ELSE fg.item_type
            END AS product_item_type_name

        FROM bom_detail bd

        LEFT JOIN item mat
            ON mat.item_id = bd.item_id

        LEFT JOIN bom b
            ON b.bom_id = bd.bom_id

        LEFT JOIN item fg
            ON fg.item_id = b.item_id

        WHERE bd.bom_detail_id = #{bomDetailId}

    </select>


    <!-- =========================================================
         6. BOM 상세 구성품 등록 / 수정 / 삭제
         ========================================================= -->

    <!--
        BOM 상세 구성품 등록

        bom_detail_id 생성 기준:
        - 현재 DB에는 별도 시퀀스가 없으므로 MAX + 1 방식으로 생성한다.
    -->
    <insert id="insertBomDetail"
            parameterType="kr.or.saeroi.dto.BomDetailDTO">

        <selectKey keyProperty="bomDetailId" resultType="int" order="BEFORE">
            SELECT NVL(MAX(bom_detail_id), 0) + 1
            FROM bom_detail
        </selectKey>

        INSERT INTO bom_detail (
            bom_detail_id,
            bom_id,
            qty,
            created_date,
            updated_date,
            remark,
            item_id
        ) VALUES (
            #{bomDetailId},
            #{bomId},
            #{qty},
            SYSDATE,
            SYSDATE,
            #{remark},
            #{itemId}
        )

    </insert>


    <!--
        BOM 상세 구성품 수정

        기준:
        - bom_detail_id 기준으로 수정한다.
    -->
    <update id="updateBomDetail"
            parameterType="kr.or.saeroi.dto.BomDetailDTO">

        UPDATE bom_detail
        SET
            bom_id = #{bomId},
            qty = #{qty},
            updated_date = SYSDATE,
            remark = #{remark},
            item_id = #{itemId}
        WHERE bom_detail_id = #{bomDetailId}

    </update>


    <!--
        BOM 상세 구성품 선택 삭제

        처리 방식:
        - bom_detail 테이블에는 use_yn 컬럼이 없다.
        - 따라서 BOM 상세 구성품은 DELETE 처리한다.
    -->
    <delete id="deleteBomDetailList"
            parameterType="java.util.List">

        DELETE FROM bom_detail
        WHERE bom_detail_id IN
        <foreach collection="list"
                 item="bomDetailId"
                 open="("
                 separator=","
                 close=")">
            #{bomDetailId}
        </foreach>

    </delete>


    <!--
        BOM ID 기준 BOM 상세 전체 삭제

        사용 위치:
        - BOM 마스터 + 구성품 전체 수정 시
        - 기존 구성품 전체 삭제 후 화면 구성품 재등록
    -->
    <delete id="deleteBomDetailByBomId"
            parameterType="int">

        DELETE FROM bom_detail
        WHERE bom_id = #{bomId}

    </delete>


    <!--
        BOM 상세 구성품 중복 확인

        기준:
        - 같은 bom_id 안에서 같은 item_id가 중복 등록되면 안 된다.
        - 수정 시 현재 bom_detail_id는 제외한다.
    -->
    <select id="selectBomDetailItemCount"
            parameterType="kr.or.saeroi.dto.BomDetailDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom_detail
        WHERE bom_id = #{bomId}
          AND item_id = #{itemId}

        <if test="bomDetailId != null">
            AND bom_detail_id != #{bomDetailId}
        </if>

    </select>


    <!-- =========================================================
         7. 완제품 / 자재 자동완성
         ========================================================= -->

    <!--
        완제품 자동완성 조회

        사용 위치:
        - BOM 등록 모달의 완제품 검색 input

        대상:
        - item_type = 'FG'
        - use_yn = 'Y'

        정렬 기준:
        1. 품목명이 검색어와 정확히 일치
        2. 품목명이 검색어로 시작
        3. 품목코드가 검색어와 정확히 일치
        4. 품목코드가 검색어로 시작
        5. 품목코드 오름차순

        제한:
        - 최대 10건
    -->
    <select id="selectProductItemAutoComplete"
            parameterType="map"
            resultMap="itemAutoCompleteResultMap">

        SELECT
            item_id,
            supplier_id,
            client_id,
            item_code,
            item_name,
            item_type,
            safety_stock,
            item_unit,
            remark,
            created_date,
            updated_date,
            use_yn,

            CASE
                WHEN item_type = 'FG' THEN '완제품'
                WHEN item_type = 'RM' THEN '원자재'
                WHEN item_type = 'SM' THEN '부자재'
                ELSE item_type
            END AS item_type_name,

            CASE
                WHEN use_yn = 'Y' THEN '사용'
                WHEN use_yn = 'N' THEN '미사용'
                ELSE use_yn
            END AS use_yn_name

        FROM (
            SELECT
                item_id,
                supplier_id,
                client_id,
                item_code,
                item_name,
                item_type,
                safety_stock,
                item_unit,
                remark,
                created_date,
                updated_date,
                use_yn
            FROM item
            WHERE use_yn = 'Y'
              AND item_type = 'FG'
              AND (
                    UPPER(item_name) LIKE '%' || UPPER(#{keyword}) || '%'
                    OR UPPER(item_code) LIKE '%' || UPPER(#{keyword}) || '%'
              )
            ORDER BY
                CASE
                    WHEN UPPER(item_name) = UPPER(#{keyword}) THEN 1
                    WHEN UPPER(item_name) LIKE UPPER(#{keyword}) || '%' THEN 2
                    WHEN UPPER(item_code) = UPPER(#{keyword}) THEN 3
                    WHEN UPPER(item_code) LIKE UPPER(#{keyword}) || '%' THEN 4
                    ELSE 5
                END,
                item_code
        )
        WHERE ROWNUM &lt;= 10

    </select>


