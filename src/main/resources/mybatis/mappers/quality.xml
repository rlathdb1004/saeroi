<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.quality">
	<!-- 검사관리 리스트 -->
	<select id="_select_Inspection" resultType="kr.or.saeroi.dto.InspectionDTO">
		SELECT
		1 AS inspId,
		SYSDATE AS inspDate,
		'가스켓' AS item_name,
		'합격' AS result
		FROM DUAL
	</select>
</mapper>
