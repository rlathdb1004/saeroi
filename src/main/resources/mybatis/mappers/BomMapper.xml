<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    BOM 관리 Mapper

    역할:
    - 기준정보관리 > BOM관리에서 사용하는 SQL을 관리한다.
    - bom 테이블을 기준으로 BOM 마스터 목록/상세/등록/수정/삭제를 처리한다.
    - bom_detail 테이블을 기준으로 BOM 상세 원자재/부자재 목록/등록/수정/삭제를 처리한다.

    DB 기준:
    - 최신 safe_names 기준
    - 테이블명/컬럼명에 큰따옴표 사용 안 함

    관련 테이블:
    - bom        : BOM 마스터
    - bom_detail : BOM 상세 자재 소요량
    - item       : 완제품/원자재/부자재 품목 기준정보

    화면 기준:
    - PC 목록 테이블은 체크박스, 상세 포함 최대 8개 컬럼 기준
    - 모바일 목록 테이블은 체크박스 포함 5개 컬럼 기준
    - 상세 화면에서는 BOM 마스터 정보와 BOM 상세 자재 목록을 함께 출력한다.
-->
<mapper namespace="bom">

    <!--
        BOM 마스터 조회 결과를 BomDTO에 매핑한다.

        DB 컬럼명:
        - bom_id, bom_code, use_yn, item_id

        DTO 필드명:
        - bomId, bomCode, useYn, itemId

        컬럼명과 필드명이 다르기 때문에 resultMap으로 직접 연결한다.
    -->
    <resultMap id="bomResultMap" type="kr.or.saeroi.dto.BomDTO">

        <!-- bom 테이블 기본 컬럼 -->
        <id property="bomId" column="bom_id" />

        <result property="bomCode" column="bom_code" />
        <result property="version" column="version" />
        <result property="useYn" column="use_yn" />
        <result property="remark" column="remark" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="itemId" column="item_id" />

        <!-- 완제품 item JOIN 표시 컬럼 -->
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="itemTypeName" column="item_type_name" />
        <result property="itemUnit" column="item_unit" />

        <!-- 화면 표시 / 집계 컬럼 -->
        <result property="useYnName" column="use_yn_name" />
        <result property="detailCount" column="detail_count" />
        <result property="totalQty" column="total_qty" />

    </resultMap>


    <!--
        BOM 상세 조회 결과를 BomDetailDTO에 매핑한다.

        기준:
        - bom_detail 1건은 BOM에 포함된 원자재/부자재 1건을 의미한다.
        - item 조인을 통해 자재코드, 자재명, 단위, 품목구분을 함께 조회한다.
    -->
    <resultMap id="bomDetailResultMap" type="kr.or.saeroi.dto.BomDetailDTO">

        <!-- bom_detail 테이블 기본 컬럼 -->
        <id property="bomDetailId" column="bom_detail_id" />

        <result property="bomId" column="bom_id" />
        <result property="qty" column="qty" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="remark" column="remark" />
        <result property="itemId" column="item_id" />

        <!-- 원자재/부자재 item JOIN 표시 컬럼 -->
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="itemTypeName" column="item_type_name" />
        <result property="itemUnit" column="item_unit" />

        <!-- BOM 마스터 JOIN 표시 컬럼 -->
        <result property="bomCode" column="bom_code" />
        <result property="version" column="version" />
        <result property="useYn" column="use_yn" />

    </resultMap>


    <!--
        자동완성용 품목 조회 결과를 ItemDTO에 매핑한다.

        사용 위치:
        - BOM 등록 모달의 완제품 자동완성
        - BOM 상세 자재 추가의 원자재/부자재 자동완성
    -->
    <resultMap id="itemAutoCompleteResultMap" type="kr.or.saeroi.dto.ItemDTO">

        <id property="itemId" column="item_id" />

        <result property="supplierId" column="supplier_id" />
        <result property="clientId" column="client_id" />
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="itemType" column="item_type" />
        <result property="safetyStock" column="safety_stock" />
        <result property="itemUnit" column="item_unit" />
        <result property="remark" column="remark" />
        <result property="createdDate" column="created_date" />
        <result property="updatedDate" column="updated_date" />
        <result property="useYn" column="use_yn" />

        <result property="itemTypeName" column="item_type_name" />
        <result property="useYnName" column="use_yn_name" />

    </resultMap>


    <!--
        BOM 목록 조회

        사용 위치:
        - 기준정보관리 > BOM관리 목록 화면

        검색 방식:
        - 화면에는 "구분" selectbox 1개와 "검색어" input 1개를 둔다.
        - searchType 값에 따라 검색 대상 컬럼이 달라진다.

        searchType 값:
        - bomCode  : BOM코드
        - itemCode : 완제품코드
        - itemName : 완제품명
        - useYn    : 사용여부
        - material : 구성자재 코드/명

        목록 표시 기준:
        - BOM 마스터 1건당 1행
        - 상세 자재 수(detail_count), 총 소요량(total_qty)을 함께 조회한다.
    -->
    <select id="selectBomList"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultMap="bomResultMap">

        SELECT
            b.bom_id,
            b.bom_code,
            b.version,
            b.use_yn,
            b.remark,
            b.created_date,
            b.updated_date,
            b.item_id,

            i.item_code,
            i.item_name,
            i.item_type,
            i.item_unit,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            NVL(d.detail_count, 0) AS detail_count,
            NVL(d.total_qty, 0) AS total_qty

        FROM bom b

        INNER JOIN item i
            ON i.item_id = b.item_id

        LEFT JOIN (
            SELECT
                bom_id,
                COUNT(*) AS detail_count,
                SUM(qty) AS total_qty
            FROM bom_detail
            GROUP BY bom_id
        ) d
            ON d.bom_id = b.bom_id

        <where>
            <if test="searchType != null and searchType != ''
                      and searchKeyword != null and searchKeyword != ''">

                <choose>

                    <!-- BOM코드 검색 -->
                    <when test="searchType == 'bomCode'">
                        AND UPPER(b.bom_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 완제품코드 검색 -->
                    <when test="searchType == 'itemCode'">
                        AND UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 완제품명 검색 -->
                    <when test="searchType == 'itemName'">
                        AND UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <!-- 사용여부 검색 -->
                    <when test="searchType == 'useYn'">
                        AND b.use_yn = UPPER(#{searchKeyword})
                    </when>

                    <!-- 구성자재 검색 -->
                    <when test="searchType == 'material'">
                        AND EXISTS (
                            SELECT
                                1
                            FROM bom_detail bd
                            INNER JOIN item mi
                                ON mi.item_id = bd.item_id
                            WHERE bd.bom_id = b.bom_id
                              AND (
                                      UPPER(mi.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                                   OR UPPER(mi.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                              )
                        )
                    </when>

                    <!-- 전체 검색 -->
                    <otherwise>
                        AND (
                                UPPER(b.bom_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                             OR UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                             OR UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                        )
                    </otherwise>

                </choose>

            </if>
        </where>

        ORDER BY b.bom_id DESC

    </select>


    <!--
        BOM 총 건수 조회

        사용 위치:
        - 목록 상단의 "총 n건" 표시
        - Controller 페이징 계산
    -->
    <select id="selectBomCount"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom b

        INNER JOIN item i
            ON i.item_id = b.item_id

        <where>
            <if test="searchType != null and searchType != ''
                      and searchKeyword != null and searchKeyword != ''">

                <choose>

                    <when test="searchType == 'bomCode'">
                        AND UPPER(b.bom_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <when test="searchType == 'itemCode'">
                        AND UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <when test="searchType == 'itemName'">
                        AND UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                    </when>

                    <when test="searchType == 'useYn'">
                        AND b.use_yn = UPPER(#{searchKeyword})
                    </when>

                    <when test="searchType == 'material'">
                        AND EXISTS (
                            SELECT
                                1
                            FROM bom_detail bd
                            INNER JOIN item mi
                                ON mi.item_id = bd.item_id
                            WHERE bd.bom_id = b.bom_id
                              AND (
                                      UPPER(mi.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                                   OR UPPER(mi.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                              )
                        )
                    </when>

                    <otherwise>
                        AND (
                                UPPER(b.bom_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                             OR UPPER(i.item_code) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                             OR UPPER(i.item_name) LIKE '%' || UPPER(#{searchKeyword}) || '%'
                        )
                    </otherwise>

                </choose>

            </if>
        </where>

    </select>


    <!--
        BOM 상세 조회

        사용 위치:
        - BOM 목록의 상세 버튼 클릭
        - BOM 상세보기 페이지

        조건:
        - bom_id 기준으로 BOM 마스터 1건 조회
    -->
    <select id="selectBomDetail"
            parameterType="int"
            resultMap="bomResultMap">

        SELECT
            b.bom_id,
            b.bom_code,
            b.version,
            b.use_yn,
            b.remark,
            b.created_date,
            b.updated_date,
            b.item_id,

            i.item_code,
            i.item_name,
            i.item_type,
            i.item_unit,

            CASE
                WHEN i.item_type = 'FG' THEN '완제품'
                WHEN i.item_type = 'RM' THEN '원자재'
                WHEN i.item_type = 'SM' THEN '부자재'
                ELSE i.item_type
            END AS item_type_name,

            CASE
                WHEN b.use_yn = 'Y' THEN '사용'
                WHEN b.use_yn = 'N' THEN '미사용'
                ELSE b.use_yn
            END AS use_yn_name,

            NVL(d.detail_count, 0) AS detail_count,
            NVL(d.total_qty, 0) AS total_qty

        FROM bom b

        INNER JOIN item i
            ON i.item_id = b.item_id

        LEFT JOIN (
            SELECT
                bom_id,
                COUNT(*) AS detail_count,
                SUM(qty) AS total_qty
            FROM bom_detail
            GROUP BY bom_id
        ) d
            ON d.bom_id = b.bom_id

        WHERE b.bom_id = #{bomId}

    </select>


    <!--
        BOM 상세 자재 목록 조회

        사용 위치:
        - BOM 상세보기 페이지의 구성 자재 목록
        - BOM 1개에 포함된 원자재/부자재 소요량을 출력한다.
    -->
    <select id="selectBomDetailList"
            parameterType="int"
            resultMap="bomDetailResultMap">

        SELECT
            bd.bom_detail_id,
            bd.bom_id,
            bd.qty,
            bd.created_date,
            bd.updated_date,
            bd.remark,
            bd.item_id,

            mi.item_code,
            mi.item_name,
            mi.item_type,
            mi.item_unit,

            CASE
                WHEN mi.item_type = 'FG' THEN '완제품'
                WHEN mi.item_type = 'RM' THEN '원자재'
                WHEN mi.item_type = 'SM' THEN '부자재'
                ELSE mi.item_type
            END AS item_type_name,

            b.bom_code,
            b.version,
            b.use_yn

        FROM bom_detail bd

        INNER JOIN bom b
            ON b.bom_id = bd.bom_id

        INNER JOIN item mi
            ON mi.item_id = bd.item_id

        WHERE bd.bom_id = #{bomId}

        ORDER BY
            bd.bom_detail_id ASC

    </select>


    <!--
        BOM 마스터 등록

        사용 위치:
        - BOM 등록 모달 저장 처리

        ID 생성:
        - 현재 프로젝트는 더미데이터에서 ID를 직접 넣는 구조와 맞춰
          MAX(bom_id) + 1 방식으로 생성한다.

        BOM코드 예:
        - BOM-FG-GSK-ION5-EPDM-001
    -->
    <insert id="insertBom"
            parameterType="kr.or.saeroi.dto.BomDTO">

        <selectKey keyProperty="bomId"
                   resultType="int"
                   order="BEFORE">
            SELECT
                NVL(MAX(bom_id), 0) + 1
            FROM bom
        </selectKey>

        INSERT INTO bom (
            bom_id,
            bom_code,
            version,
            use_yn,
            remark,
            created_date,
            updated_date,
            item_id
        ) VALUES (
            #{bomId},
            #{bomCode},
            NVL(#{version}, 1),
            NVL(#{useYn}, 'Y'),
            #{remark},
            SYSDATE,
            SYSDATE,
            #{itemId}
        )

    </insert>


    <!--
        BOM 마스터 수정

        사용 위치:
        - BOM 상세 페이지 수정 저장 처리

        기준:
        - bom_id 기준으로 수정한다.
        - created_date는 최초 등록일이므로 수정하지 않는다.
        - updated_date는 수정 시점의 SYSDATE로 갱신한다.
    -->
    <update id="updateBom"
            parameterType="kr.or.saeroi.dto.BomDTO">

        UPDATE bom
        SET
            bom_code = #{bomCode},
            version = #{version},
            use_yn = #{useYn},
            remark = #{remark},
            updated_date = SYSDATE,
            item_id = #{itemId}
        WHERE bom_id = #{bomId}

    </update>


    <!--
        BOM 선택 삭제

        사용 위치:
        - BOM 목록 화면의 선택 삭제 버튼

        처리 방식:
        - 기준정보는 다른 테이블에서 참조될 수 있으므로 실제 DELETE가 아니라 use_yn = 'N' 처리한다.
    -->
    <update id="deleteBomList"
            parameterType="java.util.List">

        UPDATE bom
        SET
            use_yn = 'N',
            updated_date = SYSDATE
        WHERE bom_id IN
        <foreach collection="list"
                 item="bomId"
                 open="("
                 separator=","
                 close=")">
            #{bomId}
        </foreach>

    </update>


    <!--
        BOM 상세 1건 등록

        사용 위치:
        - BOM 등록 시 구성 자재 저장
        - BOM 상세 수정 시 구성 자재 추가
    -->
    <insert id="insertBomDetail"
            parameterType="kr.or.saeroi.dto.BomDetailDTO">

        <selectKey keyProperty="bomDetailId"
                   resultType="int"
                   order="BEFORE">
            SELECT
                NVL(MAX(bom_detail_id), 0) + 1
            FROM bom_detail
        </selectKey>

        INSERT INTO bom_detail (
            bom_detail_id,
            bom_id,
            qty,
            created_date,
            updated_date,
            remark,
            item_id
        ) VALUES (
            #{bomDetailId},
            #{bomId},
            #{qty},
            SYSDATE,
            SYSDATE,
            #{remark},
            #{itemId}
        )

    </insert>


    <!--
        BOM 상세 1건 수정

        사용 위치:
        - BOM 상세 페이지에서 구성 자재 소요량 또는 비고 수정
    -->
    <update id="updateBomDetail"
            parameterType="kr.or.saeroi.dto.BomDetailDTO">

        UPDATE bom_detail
        SET
            qty = #{qty},
            remark = #{remark},
            updated_date = SYSDATE,
            item_id = #{itemId}
        WHERE bom_detail_id = #{bomDetailId}

    </update>


    <!--
        BOM 상세 1건 삭제

        사용 위치:
        - BOM 상세 페이지에서 구성 자재 1건 제거

        처리 방식:
        - bom_detail은 BOM 마스터에 종속된 하위 데이터이므로 물리 삭제한다.
    -->
    <delete id="deleteBomDetail"
            parameterType="int">

        DELETE FROM bom_detail
        WHERE bom_detail_id = #{bomDetailId}

    </delete>


    <!--
        특정 BOM의 상세 전체 삭제

        사용 위치:
        - BOM 수정 시 기존 상세를 전체 삭제 후 다시 등록하는 방식으로 사용할 수 있다.
    -->
    <delete id="deleteBomDetailByBomId"
            parameterType="int">

        DELETE FROM bom_detail
        WHERE bom_id = #{bomId}

    </delete>


    <!--
        BOM코드 중복 확인

        사용 위치:
        - BOM 등록 전 중복 검사
        - BOM 수정 시 현재 BOM을 제외한 중복 검사

        설명:
        - bomId가 null이면 등록 중복검사
        - bomId가 있으면 수정 중복검사
    -->
    <select id="selectBomCodeCount"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom
        WHERE bom_code = #{bomCode}

        <if test="bomId != null">
            AND bom_id != #{bomId}
        </if>

    </select>


    <!--
        완제품 품목 중복 BOM 확인

        사용 위치:
        - BOM 등록 전 완제품 item_id 중복 검사
        - BOM 수정 시 현재 BOM을 제외한 완제품 item_id 중복 검사

        기준:
        - 완제품 1개에는 기본 BOM 1개만 등록하는 기준이다.
    -->
    <select id="selectBomItemCount"
            parameterType="kr.or.saeroi.dto.BomDTO"
            resultType="int">

        SELECT
            COUNT(*)
        FROM bom
        WHERE item_id = #{itemId}

        <if test="bomId != null">
            AND bom_id != #{bomId}
        </if>

    </select>


    <!--
        BOM 등록용 완제품 자동완성

        사용 위치:
        - BOM 등록 모달의 완제품명/완제품코드 자동완성

        조건:
        - item_type = 'FG'
        - use_yn = 'Y'
    -->
    <select id="selectProductItemAutoComplete"
            parameterType="map"
            resultMap="itemAutoCompleteResultMap">

        SELECT
            item_id,
            supplier_id,
            client_id,
            item_code,
            item_name,
            item_type,
            safety_stock,
            item_unit,
            remark,
            created_date,
            updated_date,
            use_yn,

            CASE
                WHEN item_type = 'FG' THEN '완제품'
                WHEN item_type = 'RM' THEN '원자재'
                WHEN item_type = 'SM' THEN '부자재'
                ELSE item_type
            END AS item_type_name,

            CASE
                WHEN use_yn = 'Y' THEN '사용'
                WHEN use_yn = 'N' THEN '미사용'
                ELSE use_yn
            END AS use_yn_name

        FROM item

        WHERE use_yn = 'Y'
          AND item_type = 'FG'
          AND (
                  UPPER(item_code) LIKE '%' || UPPER(#{keyword}) || '%'
               OR UPPER(item_name) LIKE '%' || UPPER(#{keyword}) || '%'
          )

        ORDER BY item_code ASC

    </select>


    <!--
        BOM 상세 등록용 원자재/부자재 자동완성

        사용 위치:
        - BOM 등록 모달 또는 상세 수정 화면의 구성 자재 자동완성

